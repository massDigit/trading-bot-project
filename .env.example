# Copier ce fichier en .env.demo (`cp .env.example .env.demo && chmod 600 .env.demo`)
# puis renseigner les valeurs LOCALEMENT. Ne jamais commiter .env.demo, ne jamais coller
# ces valeurs dans un chat, un ticket ou un journal.
#
# V1 : environnement verrouillé sur https://demo-api.ig.com/gateway/deal.
# L'URL n'est volontairement pas configurable (IG_BASE_URL est refusée).
# Un futur fichier .env.live (réel) restera distinct et n'est pas lu en V1.

# Clé API générée depuis le compte DÉMO IG (My Account > API keys).
IG_API_KEY=your-demo-api-key-here

# Identifiants de connexion du compte DÉMO (différents du compte réel).
IG_USERNAME=your-demo-username
IG_PASSWORD=your-demo-password

# Optionnel : compte à sélectionner. Vide = compte actif à la connexion.
IG_ACCOUNT_ID=

# Optionnel : terme de recherche du marché (défaut : EUR/USD).
IG_MARKET_SEARCH_TERM=EUR/USD
